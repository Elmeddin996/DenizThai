@model Categorie
@{
    ViewData["Title"] = "Edit";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <h1>Redaktə Et</h1>
        <form asp-action="edit" method="post" enctype="multipart/form-data">
            <div class="form-group">
                <label asp-for="NameAz">Kategoriya Adı Az</label>
                <input class="form-control" placeholder="Kategoriya Adı Əlavə Edin" asp-for="NameAz">
            </div>
            <div class="form-group">
                <label asp-for="NameRu">Kategoriya Adı Ru</label>
                <input class="form-control" placeholder="Kategoriya Adı Əlavə Edin" asp-for="NameRu">
            </div>
            <div class="form-group">
                <label asp-for="NameEn">Kategoriya Adı En</label>
                <input class="form-control" placeholder="Kategoriya Adı Əlavə Edin" asp-for="NameEn">
            </div>

            <div class="form-group">
                <label asp-for="ImageFile">Əsas Şəkil</label>
                <input class="form-control" asp-for="ImageFile">
                <span class="text-danger" asp-validation-for="ImageFile"></span>
            </div>
            <div class="img-box" style="position:relative;margin-right:14px">
                <img width="200" src="~/uploads/categories/@Model.Image" />
            </div>


            <button type="submit" class="btn btn-primary">Submit</button>
        </form>
    </div>
</div>

