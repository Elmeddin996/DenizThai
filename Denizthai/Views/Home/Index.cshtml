@model HomeViewModel

@{
    ViewData["Title"] = "Home Page";

    var lang = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;

}

<style>
    .tour-img {
        transition: transform 0.5s ease;
    }

        .tour-img:hover {
            transform: scale(1.05);
        }

    .category-text {
        display: inline-block;
        max-width: 100%;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        vertical-align: middle;
    }

    
    /* ============================= */
    /* HOME CATEGORIES SECTION */
    /* ============================= */

    .section-title {
        text-align: center;
        margin-bottom: 40px;
        font-size: 40px;
        font-weight: 700;
        color: black;
        letter-spacing: 1px;
    }


    .home-categories {
        padding: 70px 0 60px;
        background: linear-gradient( 180deg, #eef4ff 0%, #e0ebff 100% );
    }

    /* GRID */
    .glow-category-list {
        display: grid;
        grid-template-columns: repeat(5, 1fr); /* 🔹 desktop 5 */
        gap: 20px;
    }

    /* CARD */
    .glow-category.image-category {
        position: relative;
        height: 180px; /* 🔹 kiçildildi */
        border-radius: 34px; /* 🔹 daha oval */
        background-size: cover;
        background-position: center;
        text-decoration: none;
        overflow: hidden;
        display: flex;
        align-items: flex-end;
        box-shadow: 0 10px 26px rgba(0,0,0,0.18);
        transition: transform 0.45s cubic-bezier(.4,0,.2,1), box-shadow 0.45s ease;
    }

    /* OVERLAY */
    .image-overlay {
        position: absolute;
        inset: 0;
        background: linear-gradient( 180deg, rgba(0,0,0,0.18), rgba(0,0,0,0.78) );
        z-index: 1;
        transition: all 0.45s ease;
    }

    /* TEXT */
    .glow-category .text {
        position: relative;
        z-index: 2;
        color: #ffffff;
        font-size: 17px;
        font-weight: 600;
        padding: 18px 22px;
        line-height: 1.3;
        text-shadow: 0 4px 14px rgba(0,0,0,0.6);
    }

    /* DOT */
    .glow-category .dot {
        position: absolute;
        top: 18px;
        right: 22px;
        width: 7px;
        height: 7px;
        background: #22c55e;
        border-radius: 50%;
        z-index: 2;
        opacity: 0;
        transform: scale(0);
        transition: all 0.35s ease;
    }

    /* ============================= */
    /* HOVER – DAHA MARAQLI */
    /* ============================= */

    .glow-category.image-category:hover {
        transform: translateY(-12px) scale(1.04);
        box-shadow: 0 32px 70px rgba(0,0,0,0.35);
    }

        /* overlay daha dərin olur */
        .glow-category.image-category:hover .image-overlay {
            background: linear-gradient( 180deg, rgba(0,0,0,0.05), rgba(0,0,0,0.9) );
        }

        /* text azca yuxarı qalxır */
        .glow-category.image-category:hover .text {
            transform: translateY(-6px);
            transition: transform 0.35s ease;
        }

        /* dot görünür */
        .glow-category.image-category:hover .dot {
            opacity: 1;
            transform: scale(1);
        }

    /* ============================= */
    /* RESPONSIVE (CSHTML UYĞUN) */
    /* ============================= */

    @@media (max-width: 991px) {
        .glow-category-list {
            grid-template-columns: repeat(3, 1fr); /* 🔹 mobil 3 */
        }

        .glow-category.image-category {
            height: 160px;
            border-radius: 28px;
        }

        .glow-category .text {
            font-size: 16px;
            padding: 16px 18px;
        }
    }

    @@media (max-width: 480px) {
        .glow-category.image-category {
            height: 145px;
            border-radius: 24px;
        }

        .glow-category .text {
            font-size: 15px;
            padding: 14px 16px;
        }
    }

    @@media (max-width: 576px) {
        .section-title {
            font-size: 26px;
            margin-bottom: 30px;
        }
    }

</style>

<section class="home-categories">

    <div class="container">
        <h2 class="wow fadeInUp section-title" data-wow-delay=".3s">@localizer.GetLocalizedHtmlString("our tours")</h2>

        <div class="glow-category-list">

            @foreach (var cat in Model.Categories)
            {
                <a href="@Url.Action("Index", "Tour", new { categoryId = cat.Id })"
                   class="glow-category image-category"
                   style="background-image:url('uploads/categories/@cat.Image')">

                    <span class="image-overlay"></span>

                    <span class="text">
                        @(lang == "az" ? cat.NameAz :
                            lang == "en" ? cat.NameEn :
                            lang == "ru" ? cat.NameRu : cat.NameAz)
                    </span>

                    <span class="dot"></span>
                </a>
            }
        </div>

    </div>
</section>



<!-- Hero Section Start -->
<section class="hero-section hero-4">
    <div class="array-button">
        <button class="array-prev"><i class="far fa-long-arrow-left"></i></button>
        <button class="array-next"><i class="far fa-long-arrow-right"></i></button>
    </div>
    <div class="swiper hero-slider">
        <div class="swiper-wrapper">

            @foreach (var item in Model.Sliders)
            {
                <div class="swiper-slide">
                    <div class="hero-items">

                        <div class="hero-bg bg-cover" style="background-image: url('uploads/sliders/@item.Image');"></div>
                        <div class="container">
                            <div class="row g-4">
                                <div class="col-lg-12">
                                    <div class="hero-content">
                                        <h1 data-animation="fadeInUp" data-delay="1.5s">
                                            @(lang == "az" ? item.TitleAz :
                                                lang == "en" ? item.TitleEn :
                                                lang == "ru" ? item.TitleRu : item.TitleAz)
                                        </h1>
                                        <p data-animation="fadeInUp" data-delay="1.7s">
                                            @(lang == "az" ? item.DescriptionAz :
                                                lang == "en" ? item.DescriptionEn :
                                                lang == "ru" ? item.DescriptionRu : item.DescriptionAz)
                                        </p>
                                        <a href="@item.BtnUrl" class="theme-btn theme-btn-2 wow fadeInUp" data-wow-delay=".5s" style=" position: absolute;  right: 40px;  bottom: 50px;">
                                            <span>
                                                @(lang == "az" ? item.ButtonTextAz :
                                                    lang == "en" ? item.ButtonTextEn :
                                                    lang == "ru" ? item.ButtonTextRu : item.ButtonTextAz)
                                            </span> <i class="far fa-long-arrow-right"></i>
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

            }

        </div>
    </div>
</section>

