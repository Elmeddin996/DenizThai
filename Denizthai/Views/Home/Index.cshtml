<!-- Tour Section Start -->
<section class="tour-section fix section-padding">
    <div class="container">
        <div class="section-title text-center">
            <h2 class="wow fadeInUp" data-wow-delay=".3s">@localizer.GetLocalizedHtmlString("popular tours")</h2>

        </div>
        <div class="row">
            @foreach (var item in Model.Tours.Where(t => t.IsPopular))
            {
                <div class="col-xl-4 col-lg-4 col-md-6 wow fadeInUp" data-wow-delay=".2s">
                    <div class="tour-box-items mt-0">
                        <a href="@Url.Action("Detail", "Tour", new { id = item.Id })">
                            <div class="thumb">
                                <img src="~/uploads/tours/@item.Image" alt="img" class="img-fluid rounded tour-img">
                            </div>
                        </a>
                        <div class="content">
                            <span>
                                @{
                                    var cats = item.TourCategories?
                                    .Select(tc => tc.Category)
                                    .Where(c => c != null)
                                    .ToList() ?? new List<Categorie>();

                                    var catsDisplay = cats.Count == 0 ? "" : string.Join(", ",
                                    cats.Select(c => lang == "az" ? c.NameAz :
                                    lang == "en" ? c.NameEn :
                                    lang == "ru" ? c.NameRu : c.NameAz));
                                }
                                <span class="category-text">@(string.IsNullOrEmpty(catsDisplay) ? "" : catsDisplay)</span>
                                <h4>
                                    <a href="@Url.Action("Detail", "Tour", new { id = item.Id })">
                                        @(lang == "az" ? item.NameAz :
                                            lang == "en" ? item.NameEn :
                                            lang == "ru" ? item.NameRu : item.NameAz)
                                    </a>
                                </h4>
                                <h6>
                                    <span>@item.DiscountedPrice฿</span>
                                    <del>@item.Price฿</del>
                                </h6>
                                <ul class="list">
                                    <li>
                                        <i class="far fa-calendar"></i>
                                        @(lang == "az" ? item.DurationAz :
                                            lang == "en" ? item.DurationEn :
                                            lang == "ru" ? item.DurationRu : item.DurationAz)
                                    </li>
                                </ul>
                        </div>
                    </div>
                </div>

            }
        </div>
    </div>
</section>


<!-- Instagram Section Start -->
<div class="section-title text-center">
    <h2 class="wow fadeInUp" data-wow-delay=".9s">@localizer.GetLocalizedHtmlString("follow us instagram")</h2>
</div>
<div class="instagram-section fix">
    <div class="swiper instagram-slider">
        <div class="swiper-wrapper">
            @foreach (var item in Model.InstaPhotos)
            {
                <div class="swiper-slide">
                    <div class="instagram-image">
                        <img src="~/uploads/instaphotos/@item.Image" alt="img" style="width: 100%; height: 280px; object-fit: cover;">
                        <a href="https://www.instagram.com/denizthai/" class="icon">
                            <i class="fab fa-instagram"></i>
                        </a>
                    </div>
                </div>

            }
        </div>
    </div>

</div>
